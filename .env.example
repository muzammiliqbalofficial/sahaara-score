# Database (Neon serverless Postgres — use postgresql+psycopg:// prefix)
DATABASE_URL=postgresql+psycopg://user:password@host/project?sslmode=require

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# CORS — comma-separated origins (production example below)
# CORS_ORIGINS=["https://sahaara-reviewer.vercel.app"]

# Database tuning (dev only — leave False in production)
SQL_ECHO=false

# Scoring
MODEL_VERSION=0.1.0
MIN_MODEL_DATA_POINTS=6

# Alibaba Cloud Model Studio (Qwen-VL document parsing)
# Key from https://bailian.console.aliyun.com/ — leave empty to use the
# offline mock parser (deterministic extraction, no API cost, demo-safe).
DASHSCOPE_API_KEY=
ALIBABA_QWEN_MODEL=qwen-vl-max
